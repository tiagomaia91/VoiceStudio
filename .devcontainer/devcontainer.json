{
  "name": "Maia Voice (laboratório)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "OMNIVOICE_TORCH_VARIANT": "cpu",
    "OMNIVOICE_DATA_DIR": "/workspaces/maia-voice-data",
    "HF_HOME": "/workspaces/maia-voice-data/huggingface"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [3900],
  "portsAttributes": {
    "3900": {
      "label": "Maia Voice",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [".devcontainer/LEIA-ME.md"]
    }
  }
}
